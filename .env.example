# SERES - Centro de Masajes y Terapias Integrativas
# Archivo de ejemplo de Variables de Entorno para desarrollo local y Vercel

# 1. URL pública de tu proyecto de Supabase (Dashboard -> Settings -> API -> Project URL)
# Ejemplo: https://xyzcompanyproject.supabase.co
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# 2. Clave pública anónima de Supabase (Dashboard -> Settings -> API -> Project API Keys -> anon / public)
# NUNCA uses la clave "service_role" en el frontend!
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key_publica"

# 3. GEMINI_API_KEY (opcional, para funciones de procesamiento en servidor si se requieren)
GEMINI_API_KEY=""

# 4. URL de la aplicación desplegada
APP_URL="http://localhost:3000"
